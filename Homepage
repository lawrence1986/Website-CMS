<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CMS Professional Homepage</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
scroll-behavior:smooth;
font-family:Segoe UI,sans-serif;
}

body{
background:#f5f7fa;
overflow-x:hidden;
}

nav{
position:fixed;
top:0;
width:100%;
background:#0f172a;
padding:20px 60px;
display:flex;
justify-content:space-between;
align-items:center;
z-index:1000;
box-shadow:0 5px 20px rgba(0,0,0,.2);
}

.logo{
font-size:28px;
font-weight:bold;
color:white;
}

nav ul{
display:flex;
list-style:none;
}

nav ul li{
margin-left:25px;
}

nav ul li a{
color:white;
text-decoration:none;
font-weight:600;
transition:.3s;
padding:10px 15px;
border-radius:8px;
}

nav ul li a:hover{
background:#2563eb;
transform:translateY(-3px);
}

section{
min-height:100vh;
padding:120px 80px;
}

.hero{
background:linear-gradient(135deg,#2563eb,#14b8a6);
display:flex;
justify-content:center;
align-items:center;
text-align:center;
color:white;
}

.hero-content{
animation:float 3s infinite ease-in-out;
}

.hero h1{
font-size:65px;
margin-bottom:20px;
}

.hero p{
font-size:22px;
max-width:700px;
margin:auto;
line-height:1.6;
}

.btn{
display:inline-block;
margin-top:30px;
padding:15px 35px;
background:white;
color:#2563eb;
text-decoration:none;
font-weight:bold;
border-radius:10px;
transition:.4s;
}

.btn:hover{
transform:scale(1.1);
box-shadow:0 10px 30px rgba(255,255,255,.4);
}

@keyframes float{
50%{
transform:translateY(-10px);
}
}

.about{
background:white;
text-align:center;
}

.about h2{
font-size:45px;
margin-bottom:20px;
}

.about p{
font-size:20px;
max-width:900px;
margin:auto;
line-height:1.8;
color:#444;
}

.services{
background:#eef4ff;
text-align:center;
}

.services h2{
font-size:45px;
margin-bottom:50px;
}

.service-container{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:30px;
}

.card{
background:white;
padding:30px;
border-radius:20px;
box-shadow:0 10px 30px rgba(0,0,0,.1);
transition:.4s;
}

.card:hover{
transform:translateY(-15px) scale(1.05);
box-shadow:0 20px 40px rgba(0,0,0,.2);
}

.card h3{
margin-bottom:15px;
color:#2563eb;
}

.contact{
background:white;
text-align:center;
}

.contact h2{
font-size:45px;
margin-bottom:30px;
}

.contact-form{
max-width:600px;
margin:auto;
}

.contact-form input,
.contact-form textarea{
width:100%;
padding:15px;
margin:10px 0;
border:1px solid #ccc;
border-radius:10px;
font-size:16px;
}

.contact-form button{
background:#2563eb;
color:white;
padding:15px 35px;
border:none;
border-radius:10px;
cursor:pointer;
font-size:18px;
transition:.3s;
}

.contact-form button:hover{
transform:scale(1.05);
}

#topBtn{
position:fixed;
bottom:30px;
right:30px;
width:50px;
height:50px;
border:none;
border-radius:50%;
background:#2563eb;
color:white;
font-size:22px;
cursor:pointer;
display:none;
box-shadow:0 5px 15px rgba(0,0,0,.3);
}

#topBtn:hover{
transform:scale(1.1);
}

footer{
background:#0f172a;
color:white;
text-align:center;
padding:25px;
}

</style>

</head>

<body>

<nav>

<div class="logo">CMS Portal</div>

<ul>
<li><a href="#home">Home</a></li>
<li><a href="#about">About</a></li>
<li><a href="#services">Services</a></li>
<li><a href="#contact">Contact</a></li>
</ul>

</nav>

<section id="home" class="hero">

<div class="hero-content">

<h1>Modern Website CMS</h1>

<p>
Create, manage and grow your online presence with our powerful
Content Management System designed for businesses, creators
and organizations.
</p>

<a href="#services" class="btn">
Explore Services
</a>

</div>

</section>

<section id="about" class="about">

<h2>About Us</h2>

<p>
Welcome to CMS Portal. We are a team dedicated to helping businesses,
organizations and individuals build a strong digital presence.
Our mission is to provide reliable, secure and modern web solutions
that simplify content management while maintaining professional standards.
We believe technology should be easy to use, visually appealing and
accessible to everyone.
</p>

</section>

<section id="services" class="services">

<h2>Our Services</h2>

<div class="service-container">

<div class="card">
<h3>Website Development</h3>
<p>
Modern responsive websites built with the latest technologies.
</p>
</div>

<div class="card">
<h3>CMS Integration</h3>
<p>
Easy content management solutions for businesses and organizations.
</p>
</div>

<div class="card">
<h3>SEO Optimization</h3>
<p>
Improve your visibility and reach more customers online.
</p>
</div>

<div class="card">
<h3>Technical Support</h3>
<p>
Reliable maintenance and support whenever you need assistance.
</p>
</div>

</div>

</section>

<section id="contact" class="contact">

<h2>Contact Us</h2>

<form class="contact-form" id="contactForm">

<input id="name" type="text" placeholder="Enter Your Name">

<input id="email" type="email" placeholder="Enter Your Email">

<input id="phone" type="tel" placeholder="Enter Your Phone Number">

<textarea id="message" rows="5" placeholder="Enter Your Message"></textarea>

<button type="submit">Send Message</button>

</form>

</section>

<footer>
© <span id="year"></span> CMS Portal | Professional Content Management Solutions
</footer>

<button id="topBtn">↑</button>

<script>

window.addEventListener("load", function(){

setTimeout(function(){
alert("Welcome to CMS Portal!");
},500);

});

document.getElementById("year").textContent =
new Date().getFullYear();

const links = document.querySelectorAll("nav a");

links.forEach(function(link){

link.addEventListener("click", function(){

links.forEach(function(item){
item.style.background = "";
});

this.style.background = "#2563eb";

});

});

document.getElementById("contactForm")
.addEventListener("submit", function(e){

e.preventDefault();

let name =
document.getElementById("name").value;

let email =
document.getElementById("email").value;

let phone =
document.getElementById("phone").value;

let message =
document.getElementById("message").value;

if(
name === "" ||
email === "" ||
phone === "" ||
message === ""
){

alert("Please fill in all fields.");
return;

}

alert(
"Thank you " +
name +
"! Your message has been submitted successfully."
);

this.reset();

});

const topBtn =
document.getElementById("topBtn");

window.onscroll = function(){

if(document.documentElement.scrollTop > 300){

topBtn.style.display = "block";

}else{

topBtn.style.display = "none";

}

};

topBtn.addEventListener("click", function(){

window.scrollTo({
top:0,
behavior:"smooth"
});

});

</script>

</body>
</html>
